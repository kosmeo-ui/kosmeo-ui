{
  "name": "kosmeo-ui",
  "version": "0.1.0",
  "description": "kosmeo UI packages \u2014 React components themed with CSS variables, light and dark",
  "author": "Aaron Leman",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nx/js": "22.7.5",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.4",
    "nx": "22.7.5",
    "prettier": "^3.9.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": "22.x.x"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false
  },
  "scripts": {
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx,css}\" scripts",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx,css}\" scripts",
    "lint": "eslint packages/ scripts/",
    "sort-imports": "tsx scripts/sort-imports.ts",
    "sort-imports:check": "tsx scripts/sort-imports.ts --check",
    "build": "nx run-many -t build",
    "check": "nx run-many -t check",
    "version-plan": "nx release plan"
  }
}
